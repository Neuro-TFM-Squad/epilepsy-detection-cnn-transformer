    "from pathlib import Path\n",
    "import os\n",
    "PROJECT_ROOT = next(p for p in (Path.cwd(), *Path.cwd().parents)\n",
    "                    if (p / \"PROJECT_CONTEXT.md\").is_file() and (p / \"src\").is_dir())\n",
    "os.chdir(PROJECT_ROOT)\n"
   ]
